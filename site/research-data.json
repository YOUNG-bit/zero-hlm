    {
      "id": "agentic-real2sim",
      "question": "Why is Gaussian guidance needed for agentic real-to-sim?",
      "answer": "It provides two complementary forms of guidance: Gaussian-derived geometry anchors scene scale and layout, while matched-view Gaussian renderings from multiple viewpoints guide local refinement. Together, they improve furniture dimensions, support surfaces, and object placement. Removing both forms of guidance more than doubles interaction-region error, from 5.517 to 11.689 cm, even when captured images and camera poses remain available. This shows why image input alone is insufficient for accurate physical scene construction.",
      "figures": [
        "Figure 11"
      ],
      "tables": [
        "Table 3",
        "Table 4"
      ],
      "paper_pages": [
        7,
        20
      ],
      "cd_table": [
